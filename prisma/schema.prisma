generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  image            String?
  createdAt        DateTime  @default(now())
  stripeCustomerId String?   @unique
  tools            Tool[]
  upvotes          Upvote[]
  accounts         Account[]
  sessions         Session[]
}

model Tool {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  tagline       String
  description   String
  websiteUrl    String
  logoUrl       String?
  screenshotUrl String?
  pricingModel  PricingModel
  status        ToolStatus       @default(PENDING)
  tier          ListingTier      @default(FREE)
  featured      Boolean          @default(false)
  badgeVerified Boolean          @default(false)
  badgeCode     String           @unique
  upvotes       Int              @default(0)
  views         Int              @default(0)
  clicks        Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  submittedById String
  submittedBy   User             @relation(fields: [submittedById], references: [id])
  categories    CategoryOnTool[]
  upvoteRecords Upvote[]

  @@index([status, publishedAt])
  @@index([tier])
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
}

enum ToolStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingTier {
  FREE
  FEATURED
  SPONSOR
}

model Category {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  icon        String?
  tools       CategoryOnTool[]
}

model CategoryOnTool {
  toolId     String
  categoryId String
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([toolId, categoryId])
}

model Upvote {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
